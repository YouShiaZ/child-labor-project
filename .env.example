# Child Labor Project — environment variables
#
# Copy this file to ".env.local" for local development, and set the same two
# variables in your host (Vercel → Settings → Environment Variables).
#
# Find these in Supabase → Project Settings → API.
# Leaving them BLANK keeps the app in demo mode (localStorage, mock auth).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
